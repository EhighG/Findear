# Findear 환경변수 템플릿
#   cp .env.example .env 후 필요한 값만 바꿔서 쓴다. .env는 커밋하지 않는다 (public 레포).
#   전체 목록·설명: docs/restoration/06-db-and-config.md §6
#   main·batch·match·인프라·모니터링·배포가 쓰는 변수 전체다 (R-xx마다 추가해 왔다, D-43).
#   아래 비밀번호는 로컬 개발용 예시 값이다. 배포 서버에서는 반드시 바꾼다.

# --- compose ---
COMPOSE_PROJECT_NAME=findear
# monitoring이면 Prometheus·Grafana·exporter·cAdvisor도 같이 뜬다. 비우면 모니터링 제외
COMPOSE_PROFILES=monitoring
TZ=Asia/Seoul

# --- MySQL ---
MYSQL_DATABASE=findear
MYSQL_USER=findear
MYSQL_PASSWORD=findear-local-password
MYSQL_ROOT_PASSWORD=root-local-password
# mysqld-exporter 전용 계정 비밀번호. MySQL 최초 초기화 때만 계정이 만들어지므로
# 나중에 바꾸려면 볼륨을 지우고 다시 초기화하거나 MySQL에서 직접 ALTER USER 한다. 작은따옴표(')·역슬래시는 쓰지 않는다
MYSQL_EXPORTER_PASSWORD=exporter-local-password

# --- 이미지 스토리지 (로컬은 SeaweedFS, 06 §4) ---
STORAGE_BUCKET=findear-images
# presigned URL(업로드)을 서명할 때 쓰는, 브라우저·curl이 접근할 스토리지 주소. compose 안의 main은 http://seaweedfs:8333로 직접 접근하지만
# 서명에는 Host가 들어가므로 이 주소로 서명해야 한다. SEAWEEDFS_HOST_PORT를 바꿨으면 같이 바꾼다. AWS S3는 빈 값
STORAGE_PUBLIC_ENDPOINT=http://localhost:8333
# API 응답의 이미지 URL = 이 값 + "/" + object key. AWS S3는 https://{버킷}.s3.ap-northeast-2.amazonaws.com (또는 CloudFront)
STORAGE_PUBLIC_BASE_URL=http://localhost:8333/findear-images
# SeaweedFS는 true, AWS S3는 false
STORAGE_PATH_STYLE=true
# presigned PUT URL 유효 시간(초)
STORAGE_PRESIGN_EXPIRE_SECONDS=600
AWS_REGION=ap-northeast-2
# SeaweedFS용 임의 자격증명 (영문·숫자, 16자 이상 권장). AWS에서는 비우고 EC2 IAM Role을 쓴다
AWS_ACCESS_KEY_ID=findearlocalaccesskey
AWS_SECRET_ACCESS_KEY=findearlocalsecretkey0123456789
# 브라우저가 presigned URL로 직접 업로드할 때의 허용 origin (쉼표 구분). 5500 = FCM 테스트 페이지
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5500

# --- main ---
# local이면 개발용 설정(SQL 로그 등), 배포는 prod
SPRING_PROFILES_ACTIVE=local
# Base64, 256bit 이상. 아래는 로컬 개발용 예시 값이다. 배포 서버에서는 반드시 새로 생성한다: openssl rand -base64 32
JWT_SECRET=X1eRfWwDDp4Uso7VuRvAQVSyK56bu6M+WYtJlyv+mFQ=
JWT_ACCESS_TTL_MS=7200000
# 배포는 필수 (compose.prod.yml에서 Redis에 --requirepass 적용). 로컬은 비워 둔다
REDIS_PASSWORD=
# 배포 필수. compose.prod.yml이 Elasticsearch 보안을 켜고(내장 elastic 사용자의 비밀번호) batch·es-exporter가 이 값으로 인증한다. 로컬은 비워 둔다 (로컬 ES는 보안 off)
ELASTIC_PASSWORD=
# 외부 서비스 키. 1차 작업 후 발급해서 채운다(R-91). 비어 있어도 main은 기동한다
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=
NAVER_REDIRECT_URI=http://localhost:8080/members/login
VWORLD_API_KEY=
# 웹푸시(FCM). 키 발급은 1차 작업 후(U-04). 서비스계정 JSON을 루트 secrets/firebase-adminsdk.json에 두고 true로 바꾼다.
# false면 Firebase를 초기화하지 않고 알림(DB)만 저장한다. true인데 파일이 없으면 main 기동이 실패한다
FCM_ENABLED=false
FCM_CREDENTIALS_PATH=/run/secrets/firebase-adminsdk.json

# --- match (mock) ---
# 결정적 선택·점수에 섞는 값. 바꾸면 자동채움·매칭 결과가 달라진다
MATCH_MOCK_SEED=42
# POST 엔드포인트 응답 전 대기(ms). 0이면 대기 없음 (모니터링·지연 확인용)
MATCH_MOCK_LATENCY_MS=0
# 매칭 응답의 최대 결과 수 (1 이상)
MATCH_MOCK_MAX_RESULTS=100

# --- batch ---
# 공공데이터포털 Lost112 서비스 키 (Decoding 키). 1차 작업 후 발급해서 채운다(U-05). 비어 있으면 수집하지 않는다
LOST112_SERVICE_KEY=
# true면 policeJob(기본 매일 04시)이 Lost112를 수집한다. 서버를 계속 띄워 두는 환경(배포)에서 위 키를 넣은 뒤 true로 바꾼다(D-64) (키가 없는데 true면 수집 스텝이 FAILED로 기록된다).
# false여도 수동 수집 POST /search/save(batch 내부 API)는 가능하고, 매칭은 수집 여부와 무관하게 이미 쌓인 데이터로 한다
LOST112_COLLECT_ENABLED=false
# Lost112 수집 범위: 오늘-N일 ~ 오늘, 요청 한 번의 건수(numOfRows). 운영값은 트래픽 한도를 보고 정한다 (O-4).
# 개발계정 일일 한도는 호출 수 기준: 포털기관 10,000회, 경찰청 100,000회 (페이지 하나가 1회. 기본값으로 1회 수집에 약 94회, R-91)
LOST112_COLLECT_DAYS=30
LOST112_PAGE_SIZE=1000
# false면 스케줄 잡이 돌지 않는다 (테스트·수동 실행용)
BATCH_SCHEDULING_ENABLED=true
# 잡 실행 주기(cron). 기본값은 아래와 같고, 바꾸려면 주석만 풀고 값을 따옴표 없이 쓴다
# (값에 공백이 있고 Spring이 .env를 properties로 읽을 때 따옴표까지 값이 되므로)
# POLICE_JOB_CRON=0 0 4 * * *
# FINDEAR_JOB_CRON=0 0 */2 * * *

# --- Elasticsearch ---
# 힙은 ES_MEM_LIMIT의 절반 이하로 둔다 (D-31). 공백이 있어 따옴표로 감싼다 (셸에서 source 해도 되게)
ES_JAVA_OPTS="-Xms512m -Xmx512m"

# --- 모니터링 ---
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=grafana-local-password
PROMETHEUS_RETENTION=7d

# --- 메모리 제한: 최소 사양 기본값 (D-31). OOM이 나면 04 §5의 "여유" 값으로 올린다 ---
MAIN_MEM_LIMIT=512m
MATCH_MEM_LIMIT=256m
BATCH_MEM_LIMIT=512m
MYSQL_MEM_LIMIT=512m
REDIS_MEM_LIMIT=64m
ES_MEM_LIMIT=1g
SEAWEEDFS_MEM_LIMIT=128m
PROMETHEUS_MEM_LIMIT=256m
GRAFANA_MEM_LIMIT=512m
CADVISOR_MEM_LIMIT=128m
EXPORTER_MEM_LIMIT=32m

# --- 로컬 호스트 게시 포트 (compose.override.yml, D-44). 이미 쓰는 포트면 바꾼다 ---
# 예: PC에 MySQL이 설치돼 3306을 쓰고 있으면 MYSQL_HOST_PORT=3307
MYSQL_HOST_PORT=3306
REDIS_HOST_PORT=6379
ES_HOST_PORT=9200
SEAWEEDFS_HOST_PORT=8333
PROMETHEUS_HOST_PORT=9090
GRAFANA_HOST_PORT=3000
MAIN_HOST_PORT=8080
MATCH_HOST_PORT=8084
BATCH_HOST_PORT=8082

# --- 배포 전용 (compose.prod.yml, compose.yml의 image 이름). 로컬은 build한 이미지가 이 이름으로 태그되므로 바꿀 필요 없다 ---
# 이미지: ${IMAGE_REGISTRY}/findear-{main,batch,match}:${IMAGE_TAG}. images.yml이 latest와 전체 커밋 SHA 태그로 올린다. 롤백은 IMAGE_TAG를 이전 SHA로
IMAGE_REGISTRY=ghcr.io/ehighg
IMAGE_TAG=latest
