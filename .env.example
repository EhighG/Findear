# Findear 환경변수 템플릿
#   cp .env.example .env 후 필요한 값만 바꿔서 쓴다. .env는 커밋하지 않는다 (public 레포).
#   전체 목록·설명: docs/restoration/06-db-and-config.md §6
#   이 파일에는 지금까지 구현된 서비스가 쓰는 변수만 있다 (D-43).
#   아래 비밀번호는 로컬 개발용 예시 값이다. 배포 서버에서는 반드시 바꾼다.

# --- compose ---
COMPOSE_PROJECT_NAME=findear
TZ=Asia/Seoul

# --- MySQL ---
MYSQL_DATABASE=findear
MYSQL_USER=findear
MYSQL_PASSWORD=findear-local-password
MYSQL_ROOT_PASSWORD=root-local-password
# mysqld-exporter 전용 계정 비밀번호. MySQL 최초 초기화 때만 계정이 만들어지므로
# 나중에 바꾸려면 볼륨을 지우고 다시 초기화하거나 MySQL에서 직접 ALTER USER 한다. 작은따옴표(')·역슬래시는 쓰지 않는다
MYSQL_EXPORTER_PASSWORD=exporter-local-password

# --- 이미지 스토리지 (로컬은 SeaweedFS, 06 §4) ---
STORAGE_BUCKET=findear-images
AWS_REGION=ap-northeast-2
# SeaweedFS용 임의 자격증명 (영문·숫자, 16자 이상 권장). AWS에서는 비우고 EC2 IAM Role을 쓴다
AWS_ACCESS_KEY_ID=findearlocalaccesskey
AWS_SECRET_ACCESS_KEY=findearlocalsecretkey0123456789
# 브라우저가 presigned URL로 직접 업로드할 때의 허용 origin (쉼표 구분). 5500 = FCM 테스트 페이지
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5500

# --- Elasticsearch ---
# 힙은 ES_MEM_LIMIT의 절반 이하로 둔다 (D-31). 공백이 있어 따옴표로 감싼다 (셸에서 source 해도 되게)
ES_JAVA_OPTS="-Xms512m -Xmx512m"

# --- 메모리 제한: 최소 사양 기본값 (D-31). OOM이 나면 04 §5의 "여유" 값으로 올린다 ---
MYSQL_MEM_LIMIT=512m
REDIS_MEM_LIMIT=64m
ES_MEM_LIMIT=1g
SEAWEEDFS_MEM_LIMIT=128m

# --- 로컬 호스트 게시 포트 (compose.override.yml, D-44). 이미 쓰는 포트면 바꾼다 ---
# 예: PC에 MySQL이 설치돼 3306을 쓰고 있으면 MYSQL_HOST_PORT=3307
MYSQL_HOST_PORT=3306
REDIS_HOST_PORT=6379
ES_HOST_PORT=9200
SEAWEEDFS_HOST_PORT=8333
