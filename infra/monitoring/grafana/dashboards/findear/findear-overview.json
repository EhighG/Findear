    },
    {
      "type": "stat",
      "id": 14,
      "title": "스텝 비정상 종료 수 (COMPLETED 외)",
      "description": "선택한 시간 범위 동안 상태가 COMPLETED가 아닌(FAILED·ABANDONED·STOPPED 등) 스텝 실행 수. policeJob은 수집이 실패해도 잡이 COMPLETED라 이 값이 수집 실패를 드러낸다(D-55). 0이면 정상.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "editorMode": "code",
          "expr": "sum(clamp_min(sum by (spring_batch_step_status) (spring_batch_step_seconds_count{spring_batch_step_status!=\"COMPLETED\"}) - (sum by (spring_batch_step_status) (spring_batch_step_seconds_count{spring_batch_step_status!=\"COMPLETED\"} offset $__range) or (sum by (spring_batch_step_status) (spring_batch_step_seconds_count{spring_batch_step_status!=\"COMPLETED\"}) * 0)), 0)) or vector(0)",
          "legendFormat": "비정상 스텝",
          "refId": "A",
          "instant": true,
          "range": false
        }
