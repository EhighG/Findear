    {
      "type": "bargauge",
      "id": 12,
      "title": "잡 실행 수 (잡·상태별, 선택한 시간 범위)",
      "description": "선택한 시간 범위 동안 끝난 잡 실행 횟수를 잡 이름과 종료 상태(COMPLETED·FAILED 등)별로 센 값. batch가 한 번도 잡을 실행하지 않았으면 비어 있음.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "editorMode": "code",
          "expr": "clamp_min(sum by (spring_batch_job_name, spring_batch_job_status) (spring_batch_job_seconds_count) - (sum by (spring_batch_job_name, spring_batch_job_status) (spring_batch_job_seconds_count offset $__range) or (sum by (spring_batch_job_name, spring_batch_job_status) (spring_batch_job_seconds_count) * 0)), 0)",
          "legendFormat": "{{spring_batch_job_name}} {{spring_batch_job_status}}",
          "refId": "A",
          "instant": true,
          "range": false
        }
      ],
      "gridPos": {
