          },
          "editorMode": "code",
          "expr": "sum by (application, client_name, outcome) (rate(http_client_requests_seconds_count{application=~\"$application\", outcome!=\"SUCCESS\"}[$__rate_interval]))",
          "legendFormat": "{{application}} → {{client_name}} {{outcome}}",
          "refId": "A",
