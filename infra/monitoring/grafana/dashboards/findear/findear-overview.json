        "uid": "prometheus"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "editorMode": "code",
          "expr": "clamp_min(sum by (spring_batch_job_name) (spring_batch_job_seconds_sum) - (sum by (spring_batch_job_name) (spring_batch_job_seconds_sum offset $__range) or (sum by (spring_batch_job_name) (spring_batch_job_seconds_sum) * 0)), 0) / clamp_min(sum by (spring_batch_job_name) (spring_batch_job_seconds_count) - (sum by (spring_batch_job_name) (spring_batch_job_seconds_count offset $__range) or (sum by (spring_batch_job_name) (spring_batch_job_seconds_count) * 0)), 0)",
          "legendFormat": "{{spring_batch_job_name}}",
